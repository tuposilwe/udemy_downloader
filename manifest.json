{
    "manifest_version": 3,
    "name": "Udemy Downloader",
    "description": "Udemy downloader extension. ",
    "short_name": "Udemy download",
    "version": "3.1",
    "background": {
        "service_worker": "createWindow.js"
    },
    "icons": {
        "16": "logo.png",
        "48": "logo.png",
        "128": "logo.png"
    },
    "permissions": [
        "downloads",
        "cookies"
    ],
    "host_permissions": [
        "*://*.udemy.com/*"
    ],
    "action": {
        "default_icon": "logo.png"
    }
}